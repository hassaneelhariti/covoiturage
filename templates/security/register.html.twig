{% extends 'base.html.twig' %}
{% block body %}
<div class="card" style="max-width:420px">
    <h1>Inscription</h1>
    <p class="muted">Un même compte peut être conducteur et passager.</p>
    <form method="post">
        <label>Prénom</label><input name="firstName" required>
        <label>Nom</label><input name="lastName" required>
        <label>E-mail</label><input type="email" name="email" required>
        <label>Téléphone</label><input name="phone">
        <label>Mot de passe (8 caractères min.)</label><input type="password" name="password" minlength="8" required>
        <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
        <p><button type="submit">Créer mon compte</button></p>
    </form>
</div>
{% endblock %}
