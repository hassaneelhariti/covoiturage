<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Covoiturage{% endblock %}</title>
    <style>
        :root { --bg:#f6f7f9; --fg:#1b1f24; --card:#fff; --accent:#0b6e4f; --muted:#667; --err:#b3261e; }
        @media (prefers-color-scheme: dark) { :root { --bg:#14171a; --fg:#e8eaed; --card:#1d2227; --accent:#3ecf9a; --muted:#9aa4ad; --err:#ff8a80; } }
        body { margin:0; font:16px/1.5 system-ui, sans-serif; background:var(--bg); color:var(--fg); }
        header { background:var(--accent); color:#fff; padding:.6rem 1rem; display:flex; gap:1rem; align-items:center; flex-wrap:wrap; }
        header a { color:#fff; text-decoration:none; } header .sp { flex:1; }
        main { max-width:960px; margin:1.5rem auto; padding:0 1rem; }
        .card { background:var(--card); border-radius:10px; padding:1rem 1.2rem; margin:0 0 1rem; box-shadow:0 1px 3px #0002; }
        label { display:block; margin:.5rem 0 .2rem; font-weight:600; }
        input, select, textarea, button { font:inherit; padding:.45rem .6rem; border-radius:6px; border:1px solid #8886; background:var(--card); color:var(--fg); max-width:100%; }
        button, .btn { background:var(--accent); color:#fff; border:0; cursor:pointer; text-decoration:none; display:inline-block; padding:.45rem .9rem; border-radius:6px; }
        button.danger { background:var(--err); }
        table { width:100%; border-collapse:collapse; } th, td { text-align:left; padding:.35rem .5rem; border-bottom:1px solid #8883; }
        .flash { padding:.6rem 1rem; border-radius:8px; margin-bottom:1rem; } .flash.success { background:#0b6e4f22; } .flash.error { background:#b3261e22; color:var(--err); }
        .muted { color:var(--muted); } .row { display:flex; gap:.8rem; flex-wrap:wrap; align-items:end; }
        #map { height:320px; border-radius:10px; }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
<header>
    <a href="{{ path('app_home') }}"><strong>🚗 Covoiturage</strong></a>
    <span class="sp"></span>
    {% if app.user %}
        <a href="{{ path('app_my_bookings') }}">Mes réservations</a>
        <a href="{{ path('app_driver_trips') }}">Espace conducteur</a>
        <a href="{{ path('app_profile', {id: app.user.id}) }}">{{ app.user.firstName }}</a>
        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Admin</a>{% endif %}
        <a href="{{ path('app_logout') }}">Déconnexion</a>
    {% else %}
        <a href="{{ path('app_login') }}">Connexion</a>
        <a href="{{ path('app_register') }}">Inscription</a>
    {% endif %}
</header>
<main>
    {% for type, messages in app.flashes %}{% for m in messages %}<div class="flash {{ type }}">{{ m }}</div>{% endfor %}{% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
